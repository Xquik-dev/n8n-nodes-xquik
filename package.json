{
	"name": "n8n-nodes-xquik",
	"version": "0.1.7",
	"description": "n8n Twitter node by Xquik. Search tweets & users, read trends & check follows. Not affiliated with X Corp.",
	"license": "MIT",
	"homepage": "https://github.com/Xquik-dev/n8n-nodes-xquik",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-twitter",
		"n8n-twitter-scraper",
		"n8n-twitter-api",
		"n8n-twitter-node",
		"n8n-x-node",
		"xquik",
		"twitter-api",
		"twitter-search",
		"tweet-search"
	],
	"author": {
		"name": "Xquik",
		"email": "support@xquik.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Xquik-dev/n8n-nodes-xquik.git"
	},
	"packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npm run clean && tsc -p tsconfig.build.json && npm run copy-assets",
		"build:watch": "tsc -p tsconfig.build.json --watch",
		"check:reproducible": "node scripts/check-reproducible.mts",
		"clean": "node scripts/clean.mts",
		"copy-assets": "node scripts/copy-assets.mts",
		"lint": "npm run build && eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 . && type-coverage -p tsconfig.json --strict --at-least 100",
		"lint:fix": "npm run build && eslint --flag unstable_native_nodejs_ts_config --max-warnings 0 . --fix",
		"test": "npm run build && tsc -p tsconfig.json && node --test --experimental-test-coverage --test-coverage-branches=100 --test-coverage-functions=100 --test-coverage-include='dist/credentials/**/*.js' --test-coverage-include='dist/nodes/**/*.js' --test-coverage-lines=100 tests/*.test.mts",
		"prepublishOnly": "npm test && node scripts/verify-release.mts"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/XquikApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Xquik/Xquik.node.js"
		]
	},
	"devDependencies": {
		"@eslint/js": "9.29.0",
		"@langchain/core": "1.2.8",
		"@n8n/config": "2.42.0",
		"@n8n/eslint-plugin-community-nodes": "0.36.0",
		"@sentry/node": "10.70.0",
		"@types/express": "5.0.6",
		"@types/luxon": "3.2.0",
		"@types/node": "24.10.1",
		"@types/semver": "7.7.1",
		"@types/ssh2": "1.15.0",
		"@typescript-eslint/type-utils": "8.71.2",
		"@typescript-eslint/utils": "8.71.2",
		"eslint": "9.29.0",
		"eslint-import-resolver-typescript": "4.4.5",
		"eslint-plugin-import-x": "4.17.1",
		"eslint-plugin-n8n-nodes-base": "2.0.0",
		"globals": "17.13.0",
		"n8n-workflow": "2.44.1",
		"nock": "14.0.14",
		"type-coverage": "2.30.4",
		"type-fest": "5.10.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"zod": "3.25.76"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
