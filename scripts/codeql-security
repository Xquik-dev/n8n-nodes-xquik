#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Xquik Contributors
# SPDX-License-Identifier: MIT
#
# Analyzes the JavaScript and TypeScript source with CodeQL's security-extended
# queries, as the removed CodeQL workflow did, and fails on any result.
# Usage: scripts/codeql-security [--version]
# --version checks the CodeQL CLI and prints its version without analyzing.
set -euo pipefail
cd "$(dirname "$0")/.."
minimum_version=2.27.0
queries="codeql/javascript-queries@2.4.7:codeql-suites/javascript-security-extended.qls"
codeql="${XQUIK_CODEQL_BIN:-$(command -v codeql || true)}"
[[ -x "$codeql" ]] || {
	echo "CodeQL CLI is missing. Install it with brew install --cask codeql, then rerun." >&2
	exit 1
}
version="$("$codeql" version --format=terse)"
[[ "$(printf '%s\n' "$minimum_version" "$version" | sort -V | head -n 1)" == "$minimum_version" ]] || {
	echo "CodeQL CLI $version is older than $minimum_version. Run brew upgrade --cask codeql." >&2
	exit 1
}
if [[ "${1:-}" == --version ]]; then
	echo "$version"
	exit
fi
echo "CodeQL CLI $version"
report="$(mktemp -d "${TMPDIR:-/tmp}/n8n-xquik-codeql.XXXXXX")"
trap 'rm -rf -- "${report:?}"' EXIT
# Build output and installed packages are not source.
printf 'paths-ignore:\n  - dist\n  - node_modules\n  - coverage\n' >"$report/config.yml"
"$codeql" database create "$report/database" --language=javascript-typescript --build-mode=none \
	--source-root="$PWD" --codescanning-config="$report/config.yml" --threads=2
"$codeql" database analyze --download "$report/database" "$queries" \
	--format=sarifv2.1.0 --output="$report/report.sarif" --threads=2
node scripts/verify-codeql.mjs "$report/report.sarif"
