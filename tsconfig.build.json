{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"lib": ["es2019", "es2020", "es2022.error", "dom"],
		"noEmit": false,
		"allowImportingTsExtensions": false,
		"removeComments": true,
		"preserveConstEnums": true,
		"declaration": true,
		"sourceMap": true
	},
	"include": ["credentials/**/*", "nodes/**/*", "nodes/**/*.json", "package.json"]
}
